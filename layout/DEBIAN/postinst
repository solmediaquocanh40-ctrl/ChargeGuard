#!/bin/sh
# Tạo và nạp LaunchDaemon cho chargeguardd, đường dẫn tự dò theo rootful/rootless/roothide.
BIN=""
for c in /var/jb/usr/libexec/chargeguardd /usr/libexec/chargeguardd; do
    if [ -x "$c" ]; then BIN="$c"; break; fi
done
if [ -z "$BIN" ] && command -v jbroot >/dev/null 2>&1; then
    c="$(jbroot /usr/libexec/chargeguardd)"
    [ -x "$c" ] && BIN="$c"
fi
if [ -z "$BIN" ]; then
    echo "ChargeGuard: không tìm thấy chargeguardd, bỏ qua LaunchDaemon" >&2
    exit 0
fi
PREFIX="${BIN%/usr/libexec/chargeguardd}"
DIR="$PREFIX/Library/LaunchDaemons"
PLIST="$DIR/com.chargeguard.daemon.plist"
mkdir -p "$DIR"
cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.chargeguard.daemon</string>
	<key>ProgramArguments</key>
	<array><string>$BIN</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>UserName</key><string>root</string>
</dict>
</plist>
PL
chown root:wheel "$PLIST" 2>/dev/null
chmod 644 "$PLIST"
launchctl unload "$PLIST" 2>/dev/null
launchctl load -w "$PLIST" 2>/dev/null || launchctl bootstrap system "$PLIST" 2>/dev/null

# 0.2.1: đăng ký app ChargeGuard ngoài màn hình chính. Bản 0.2.0 thiếu bước này
# nên cài xong không thấy icon app (hệ thống chưa hề được nhờ đăng ký app).
APP=""
for c in /var/jb/Applications/ChargeGuard.app /Applications/ChargeGuard.app; do
    if [ -d "$c" ]; then APP="$c"; break; fi
done
if [ -z "$APP" ] && command -v jbroot >/dev/null 2>&1; then
    c="$(jbroot /Applications/ChargeGuard.app)"
    [ -d "$c" ] && APP="$c"
fi
UICACHE=""
for c in /var/jb/usr/bin/uicache /usr/bin/uicache; do
    if [ -x "$c" ]; then UICACHE="$c"; break; fi
done
if [ -z "$UICACHE" ] && command -v uicache >/dev/null 2>&1; then UICACHE="uicache"; fi
if [ -n "$APP" ] && [ -n "$UICACHE" ]; then
    "$UICACHE" -p "$APP" 2>/dev/null || "$UICACHE" -a 2>/dev/null || true
fi
exit 0
